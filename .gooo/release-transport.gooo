  target_commit value "DISPATCH_EXACT_MAIN_MERGE_SHA" source "workflow_dispatch.expected_sha" exact "true"
  annotated_tag tag "v0.1.7" object_sha "RUNTIME_ANNOTATED_TAG_OBJECT_SHA" target_commit_sha "DISPATCH_EXACT_MAIN_MERGE_SHA" annotated "true"
  draft_release id "RUNTIME_CREATE_RESPONSE_DRAFT_RELEASE_ID" tag "v0.1.7" target_commitish "DISPATCH_EXACT_MAIN_MERGE_SHA" draft "true"
  asset name "source-v0.1.7.tar.gz" size "RUNTIME_BYTES_FROM_SOURCE_ARCHIVE" digest "RUNTIME_SHA256_FROM_SOURCE_ARCHIVE"
  asset name "evidence-v0.1.7.tar.gz" size "RUNTIME_BYTES_FROM_EVIDENCE_ARCHIVE" digest "RUNTIME_SHA256_FROM_EVIDENCE_ARCHIVE"
  asset name "SHA256SUMS" size "RUNTIME_BYTES_FROM_CHECKSUM_MANIFEST" digest "RUNTIME_SHA256_FROM_CHECKSUM_MANIFEST"
  api_receipt id "previous-release-detail" method "GET" endpoint "repos/{repository}/releases/tags/v0.1.3" status "200" response_digest "sha256:317536372b80224bdafc85e1f29decc34a61314ae91e978fd381dd69c9978a19" resource_id "380375220" fixture "fixtures/api/v6/previous-release-detail.json"
  api_receipt id "previous-tag-ref" method "GET" endpoint "repos/{repository}/git/ref/tags/v0.1.3" status "200" response_digest "sha256:29458c096556f87f95606ae649600efa570c490710c7876751c954b56473729e" resource_id "036d3f9dcfb81511b64a34ae360ecd58b0e58fdd" fixture "fixtures/api/v6/previous-tag-ref.json"
  api_receipt id "merged-pr-lineage" method "GET" endpoint "repos/{repository}/pulls/{merged_pr_number}" status "200" response_digest "sha256:4113d99d48a2f847295ac40ce84f1bfcac83ddb2f84acbb3bad4fa66e3b18de1" resource_id "DISPATCH_MERGED_PR_NUMBER" fixture "fixtures/api/v6/merged-pr.json"
  api_receipt id "preflight-payload" method "FIXTURE" endpoint "fixtures/api/v6/conformance.json" status "200" response_digest "sha256:0f954255f62b51229e666a8f10b973c45f7f496088574c4173632da37416ce5a" resource_id "release-transport-v6" fixture "fixtures/api/v6/conformance.json"
